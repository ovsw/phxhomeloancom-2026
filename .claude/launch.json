{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--directory", "frontend/PHXHomeLoan-web-prototype"],
      "port": 4173,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "dev (root, all workspaces)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3333,
      "autoPort": false
    }
  ]
}
